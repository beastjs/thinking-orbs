{
  "name": "@beastjs/thinking-orbs",
  "version": "1.0.0",
  "description": "Dotted thought-orb loading indicators for Octane and Beast — nine tuned states, two sizes, auto dark/light",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "octane": ">=0.2.8"
  },
  "devDependencies": {
    "octane": "^0.2.10",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "octane",
    "beast",
    "tsrx",
    "loading",
    "loader",
    "spinner",
    "ai",
    "agent",
    "canvas",
    "animation"
  ],
  "author": "Jakub Antalik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beastjs/thinking-orbs.git"
  },
  "bugs": {
    "url": "https://github.com/beastjs/thinking-orbs/issues"
  },
  "homepage": "https://github.com/beastjs/thinking-orbs#readme"
}
