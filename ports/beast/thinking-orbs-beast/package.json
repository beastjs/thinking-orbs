{
  "name": "thinking-orbs-beast",
  "version": "0.1.0",
  "description": "Dotted thought-orb loading indicators for Beast and Octane — port of thinking-orbs",
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "beast compile src/ThinkingOrb.btsx --output src/ThinkingOrb.tsrx",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "octane": ">=0.2.6"
  },
  "dependencies": {
    "thinking-orbs": "^0.3.1"
  },
  "devDependencies": {
    "beast-tsrx": "^0.2.60",
    "octane": "0.2.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  },
  "keywords": [
    "beast",
    "btsx",
    "tsrx",
    "octane",
    "loading",
    "loader",
    "spinner",
    "ai",
    "agent",
    "canvas",
    "animation",
    "dark-mode"
  ],
  "author": "Jakub Antalik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jakubantalik/thinking-orbs.git",
    "directory": "ports/beast/thinking-orbs-beast"
  },
  "homepage": "https://orbs.jakubantalik.com"
}
