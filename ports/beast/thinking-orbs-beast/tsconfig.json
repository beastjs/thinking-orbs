{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  // ThinkingOrb.tsrx is validated by `npm run build` (beast compile runs
  // Octane's compiler); index.ts is covered by its hand-written index.d.ts.
  "include": ["src/theme.ts", "src/types.ts", "src/index.d.ts"]
}
